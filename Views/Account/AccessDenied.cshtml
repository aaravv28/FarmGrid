@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="card p-5 shadow-sm mx-auto" style="max-width: 500px; border-radius: 16px;">
        <div class="text-danger mb-3">
            <i class="fa-solid fa-triangle-exclamation fa-4x"></i>
        </div>
        <h2 class="mb-2">Access Denied</h2>
        <p class="text-muted">You do not have the required permissions to view this resource.</p>
        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn farm-btn-primary">
                <i class="fa-solid fa-house me-1"></i> Return Home
            </a>
        </div>
    </div>
</div>
