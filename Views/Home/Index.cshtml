@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="farm-badge">
                    Fresh from farms
                </span>

                <h1>
                    Fresh Produce
                    Direct From
                    <span>Farmers</span>
                </h1>

                <p>

                    FarmGrid connects local farmers directly
                    with consumers and businesses while helping
                    farmers reduce wastage and transportation cost.

                </p>

                <div class="hero-buttons">

                    <a asp-controller="Ui"
                       asp-action="ProductCatalog"
                       class="btn farm-btn-primary">

                        Shop Fresh Produce

                    </a>

                    <a asp-controller="Ui"
                       asp-action="FarmerDashboard"
                       class="btn farm-btn-outline">

                        Farmer Dashboard

                    </a>

                </div>

            </div>

            <div class="col-lg-6 text-center">

                <div class="hero-illustration">

                    <i class="fa-solid fa-tractor"></i>

                    <div>

                        <h3>Farm to Doorstep</h3>

                        <p>
                            Fresh • Local • Transparent
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="section-space">

    <div class="container">

        <div class="section-heading">

            <h2>Explore FarmGrid</h2>

            <p>
                Everything farmers and buyers need
                in one platform
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">

                        <i class="fa-solid fa-basket-shopping"></i>

                    </div>

                    <h4>Fresh Marketplace</h4>

                    <p>
                        Purchase fruits vegetables groceries
                        and dairy directly from farmers.
                    </p>

                    <a asp-controller="Ui"
                       asp-action="ProductCatalog">

                        Explore Marketplace →

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon quick-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <h4>Quick Sell</h4>

                    <p>
                        Urgent harvest listings automatically
                        reduce their price over time.
                    </p>

                    <a asp-controller="Ui"
                       asp-action="QuickSell">

                        View Quick Sell →

                    </a>

                </div>

            </div>


            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon transport-icon">

                        <i class="fa-solid fa-truck"></i>

                    </div>

                    <h4>Shared Transport</h4>

                    <p>
                        Farmers can share transport and reduce
                        their delivery expenses.
                    </p>

                    <a asp-controller="Ui"
                       asp-action="Transport">

                        Find Transport →

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<section class="stats-section">

    <div class="container">

        <div class="row text-center">

            <div class="col-md-3">

                <h2>150+</h2>
                <p>Farmers</p>

            </div>

            <div class="col-md-3">

                <h2>2,500+</h2>
                <p>Orders</p>

            </div>

            <div class="col-md-3">

                <h2>40+</h2>
                <p>Districts</p>

            </div>

            <div class="col-md-3">

                <h2>15 Tons</h2>
                <p>Produce Saved</p>

            </div>

        </div>

    </div>

</section>