@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="dashboard-page">

    <div class="container">

        <div class="dashboard-header">

            <div>

                <p class="small-label">
                    Customer Portal
                </p>

                <h2>
                    My Dashboard
                </h2>

                <p>
                    Track orders purchases and delivery status.
                </p>

            </div>

            <a asp-action="ProductCatalog"
               class="btn farm-btn-primary">

                Shop Now

            </a>

        </div>


        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-box-open"></i>

                    <div>

                        <h3>3</h3>

                        <p>Active Orders</p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-clock-rotate-left"></i>

                    <div>

                        <h3>18</h3>

                        <p>Total Orders</p>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-wallet"></i>

                    <div>

                        <h3>₹8,420</h3>

                        <p>Total Purchases</p>

                    </div>

                </div>

            </div>

        </div>


        <div class="dashboard-card">

            <div class="card-title-row">

                <h4>
                    Recent Orders
                </h4>

                <a asp-action="Orders">
                    View All
                </a>

            </div>

            <div class="table-responsive">

                <table class="table farm-table">

                    <thead>

                        <tr>

                            <th>Order</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Amount</th>
                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        <tr>

                            <td>#FG1024</td>

                            <td>23 Aug 2026</td>

                            <td>4</td>

                            <td>₹760</td>

                            <td>
                                <span class="status active">
                                    Delivered
                                </span>
                            </td>

                        </tr>

                        <tr>

                            <td>#FG1023</td>

                            <td>22 Aug 2026</td>

                            <td>2</td>

                            <td>₹420</td>

                            <td>
                                <span class="status shipping">
                                    Shipped
                                </span>
                            </td>

                        </tr>

                        <tr>

                            <td>#FG1022</td>

                            <td>21 Aug 2026</td>

                            <td>5</td>

                            <td>₹1,210</td>

                            <td>
                                <span class="status pending">
                                    Placed
                                </span>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>