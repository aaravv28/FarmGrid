@model FarmGrid.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="dashboard-page py-4">
    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="dashboard-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 mb-2">
                    <i class="fa-solid fa-basket-shopping me-1"></i> Customer Portal
                </span>
                <h2 class="mb-1">Hello, @Model.CustomerName 👋</h2>
                <p class="text-muted mb-0">
                    Track your orders, Quick Sell purchases, and delivery statuses.
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-controller="Products" asp-action="Index" class="btn farm-btn-primary">
                    <i class="fa-solid fa-store me-1"></i> Browse Marketplace
                </a>
                <a asp-controller="QuickSell" asp-action="Index" class="btn btn-outline-danger">
                    <i class="fa-solid fa-bolt me-1"></i> Quick Sell Deals
                </a>
            </div>
        </div>

        <!-- Metric Stat Cards -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3">
                    <div class="p-3 bg-success-subtle text-success rounded-3 fs-3">
                        <i class="fa-solid fa-box-open"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@Model.ActiveOrdersCount</h3>
                        <p class="text-muted small mb-0">Active Orders</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3">
                    <div class="p-3 bg-primary-subtle text-primary rounded-3 fs-3">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">@Model.TotalOrdersCount</h3>
                        <p class="text-muted small mb-0">Total Orders Placed</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3">
                    <div class="p-3 bg-warning-subtle text-warning rounded-3 fs-3">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <h3 class="mb-0 fw-bold">₹@Model.TotalSpent.ToString("N0")</h3>
                        <p class="text-muted small mb-0">Total Purchases</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Retail Marketplace Orders -->
        <div class="dashboard-card card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="card-title-row d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">
                    <i class="fa-solid fa-bag-shopping text-success me-2"></i> Marketplace Orders
                </h4>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-success">
                    All Orders <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (!Model.RecentOrders.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-2">You haven't placed any retail marketplace orders yet.</p>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm farm-btn-primary">
                        <i class="fa-solid fa-cart-plus me-1"></i> Start Shopping
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Delivery Address</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th class="text-end">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ord in Model.RecentOrders)
                            {
                                <tr>
                                    <td><strong class="text-dark">#@ord.Id</strong></td>
                                    <td>@ord.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        @foreach (var item in ord.OrderItems.Take(2))
                                        {
                                            <span class="badge bg-light text-dark border me-1">@item.Quantity @item.UnitMeasure @item.ProductTitle</span>
                                        }
                                        @if (ord.OrderItems.Count > 2)
                                        {
                                            <small class="text-muted">+@(ord.OrderItems.Count - 2) more</small>
                                        }
                                    </td>
                                    <td>@ord.DeliveryAddress, @ord.City</td>
                                    <td><strong class="text-success">₹@ord.TotalAmount.ToString("F2")</strong></td>
                                    <td>
                                        <span class="badge @OrderStatuses.BadgeClass(ord.Status)">
                                            @ord.Status
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@ord.Id" class="btn btn-sm btn-outline-secondary">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Quick Sell Orders -->
        <div class="dashboard-card card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="card-title-row d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold mb-0">
                    <i class="fa-solid fa-bolt text-danger me-2"></i> Quick Sell Purchases
                </h4>
                <a asp-controller="QuickSell" asp-action="Index" class="btn btn-sm btn-outline-danger">
                    Explore Quick Sell <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>

            @if (!Model.RecentQuickSellOrders.Any())
            {
                <div class="text-center py-4 text-muted">
                    <p class="mb-2">No Quick Sell orders yet.</p>
                    <a asp-controller="QuickSell" asp-action="Index" class="btn btn-sm btn-outline-danger">
                        <i class="fa-solid fa-bolt me-1"></i> View Urgent Harvest Deals
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Purchase ID</th>
                                <th>Produce</th>
                                <th>Quantity</th>
                                <th>Price/kg</th>
                                <th>Total</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var qord in Model.RecentQuickSellOrders)
                            {
                                <tr>
                                    <td><strong>#QS-@qord.Id</strong></td>
                                    <td>@(qord.QuickSellListing?.CropTitle ?? "Produce")</td>
                                    <td>@qord.QuantityPurchased kg</td>
                                    <td>₹@qord.PricePerKg.ToString("F2")</td>
                                    <td><strong class="text-success">₹@qord.TotalAmount.ToString("F2")</strong></td>
                                    <td>@qord.PurchasedAt.ToString("dd MMM yyyy")</td>
                                    <td><span class="badge @OrderStatuses.BadgeClass(qord.Status)">@qord.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>