@model IEnumerable<FarmGrid.Models.TransportTrip>
@inject TimeProvider Time

@{
    ViewData["Title"] = "Shared Transport";
    var currentFarmerId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="transport-page py-4">

    <div class="container">

        <div class="page-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

            <div>

                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-2">
                    <i class="fa-solid fa-truck-moving me-1"></i> Smart Logistics
                </span>

                <h2 class="mb-1">
                    Shared Farmer Transport
                </h2>

                <p class="text-muted mb-0">
                    Find matching farmer transport trips, pool vehicle capacity, and cut transit expenses.
                </p>

            </div>

            <div class="d-flex gap-2">

                <a asp-controller="Transport"
                   asp-action="MyTrips"
                   class="btn farm-btn-outline">
                    <i class="fa-solid fa-list-check me-1"></i> My Trips
                </a>

                <a asp-controller="Transport"
                   asp-action="Create"
                   class="btn farm-btn-primary">

                    <i class="fa-solid fa-plus me-1"></i> Create Transport Trip

                </a>

            </div>

        </div>



        <!-- Search / Filter Card -->
        <div class="dashboard-card card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">

            <h4 class="fw-bold mb-2">
                <i class="fa-solid fa-magnifying-glass text-success me-2"></i> Find Matching Transport
            </h4>

            <p class="text-muted mb-4">
                Enter your destination market, dispatch date, and required cargo weight to find matching pooled trips.
            </p>

            <form asp-controller="Transport"
                  asp-action="Suggestions"
                  method="get">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-semibold">
                            Destination Market
                        </label>

                        <select name="destinationMarket"
                                class="form-select"
                                required>

                            <option value="">
                                Select Market
                            </option>

                            @foreach (var district in Markets.All.GroupBy(m => m.District))
                            {
                                <optgroup label="@district.Key district">
                                    @foreach (var market in district)
                                    {
                                        <option value="@market.Name">@market.Name</option>
                                    }
                                </optgroup>
                            }


                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-semibold">
                            Dispatch Date
                        </label>

                        <input type="date"
                               name="dispatchDate"
                               class="form-control"
                               value="@IndiaTime.Today(Time).ToString("yyyy-MM-dd")"
                               required />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-semibold">
                            Required Cargo Weight
                        </label>

                        <div class="input-group">

                            <input type="number"
                                   name="requiredWeight"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Example 300"
                                   required />

                            <span class="input-group-text bg-light">
                                kg
                            </span>

                        </div>

                    </div>

                </div>

                <button type="submit"
                        class="btn farm-btn-primary">

                    <i class="fa-solid fa-magnifying-glass me-1"></i> Find Matching Transport

                </button>

            </form>

        </div>

        <!-- Upcoming Active Scheduled Trips -->
        @if (Model != null && Model.Any())
        {
            <div class="dashboard-card card border-0 shadow-sm rounded-4 p-4 bg-white">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold mb-0">
                        <i class="fa-solid fa-truck text-primary me-2"></i> Open Scheduled Trips
                    </h4>
                    <span class="badge bg-primary-subtle text-primary border px-3 py-1">Available for Pooling</span>
                </div>

                <div class="row g-3">
                    @foreach (var trip in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="p-3 border rounded-3 bg-light-subtle h-100 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-success-subtle text-success border">@trip.VehicleType</span>
                                        <small class="text-muted"><i class="fa-regular fa-calendar me-1"></i> @trip.DispatchDate.ToString("dd MMM yyyy")</small>
                                    </div>

                                    <h5 class="fw-bold mb-1 text-dark">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i> @trip.DestinationMarket
                                    </h5>
                                    @if (trip.OriginDescription != null)
                                    {
                                        <small class="text-muted d-block mb-1"><i class="fa-solid fa-route me-1"></i> From @trip.OriginDescription</small>
                                    }

                                    <p class="text-muted small mb-2">
                                        Host Cargo: <strong>@trip.HostCargoWeightKg kg</strong>
                                    </p>

                                    <div class="d-flex justify-content-between small text-secondary border-top pt-2">
                                        <span>Spare Capacity:</span>
                                        <strong class="text-success fs-6">@trip.AvailableCapacityKg kg</strong>
                                    </div>

                                    <div class="d-flex justify-content-between small text-secondary">
                                        <span>Total Vehicle Cost:</span>
                                        <strong>₹@trip.TotalVehicleCost.ToString("F2")</strong>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @if (trip.FarmerId == currentFarmerId)
                                    {
                                        <span class="btn btn-sm btn-light border w-100 disabled">
                                            <i class="fa-solid fa-truck me-1"></i> Your trip
                                        </span>
                                    }
                                    else if (trip.Participants.Any(p => p.FarmerId == currentFarmerId))
                                    {
                                        <a asp-controller="Transport" asp-action="MyTrips" class="btn btn-sm btn-light border w-100">
                                            <i class="fa-solid fa-circle-check text-success me-1"></i> Joined
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Transport"
                                           asp-action="Suggestions"
                                           asp-route-destinationMarket="@trip.DestinationMarket"
                                           asp-route-dispatchDate="@trip.DispatchDate.ToString("yyyy-MM-dd")"
                                           asp-route-requiredWeight="@Math.Min(trip.AvailableCapacityKg, 100).ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                           class="btn btn-sm btn-outline-success w-100">
                                            <i class="fa-solid fa-handshake me-1"></i> Request to Join
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

            </div>
        }

    </div>

</div>