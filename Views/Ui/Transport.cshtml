@{
    ViewData["Title"] = "Shared Transport";
}

<div class="transport-page">

    <div class="container">

        <div class="page-heading">

            <div>

                <span class="farm-badge">
                    Smart Logistics
                </span>

                <h2>
                    Shared Farmer Transport
                </h2>

                <p>
                    Find matching farmer transport trips
                    and reduce delivery costs.
                </p>

            </div>

            <div class="d-flex gap-2">

                <a asp-controller="Transport"
                   asp-action="MyTrips"
                   class="btn farm-btn-outline">

                    My Trips

                </a>

                <a asp-controller="Transport"
                   asp-action="Create"
                   class="btn farm-btn-primary">

                    <i class="fa-solid fa-plus"></i>

                    Create Transport Trip

                </a>

            </div>

        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="dashboard-card">

            <h4 class="mb-2">
                Find Matching Transport
            </h4>

            <p class="text-muted mb-4">
                Enter your destination date and required
                cargo weight to find suitable trips.
            </p>

            <form asp-controller="Transport"
                  asp-action="Suggestions"
                  method="get">

                <div class="row">

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Destination Market
                        </label>

                        <select name="destinationMarket"
                                class="form-select"
                                required>

                            <option value="">
                                Select Destination
                            </option>

                            <option value="Central Mandi">
                                Central Mandi
                            </option>

                            <option value="City Hub">
                                City Hub
                            </option>

                            <option value="Wholesale Market">
                                Wholesale Market
                            </option>

                        </select>

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Dispatch Date
                        </label>

                        <input type="date"
                               name="dispatchDate"
                               class="form-control"
                               required />

                    </div>

                    <div class="col-md-4 mb-3">

                        <label class="form-label">
                            Required Cargo Weight
                        </label>

                        <div class="input-group">

                            <input type="number"
                                   name="requiredWeight"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control"
                                   placeholder="Example 300"
                                   required />

                            <span class="input-group-text">
                                kg
                            </span>

                        </div>

                    </div>

                </div>

                <button type="submit"
                        class="btn farm-btn-primary">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    Find Matching Transport

                </button>

            </form>

        </div>

    </div>

</div>