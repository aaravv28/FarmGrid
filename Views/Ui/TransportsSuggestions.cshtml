@{
    ViewData["Title"] = "Transport Suggestions";
}

<div class="transport-page">

    <div class="container">

        <div class="page-heading">

            <h2>
                Transport Suggestions
            </h2>

            <p>
                Matching trips for Central Mandi
                on 26 August.
            </p>

        </div>

        <div class="suggestion-card">

            <div class="suggestion-driver">

                <div class="avatar-circle">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h5>
                        Mahesh Patel
                    </h5>

                    <p>
                        Farmer • Anand
                    </p>

                </div>

            </div>

            <div class="suggestion-info">

                <div>

                    <small>
                        Destination
                    </small>

                    <strong>
                        Central Mandi
                    </strong>

                </div>

                <div>

                    <small>
                        Capacity Available
                    </small>

                    <strong>
                        400 kg
                    </strong>

                </div>

                <div>

                    <small>
                        Vehicle Cost
                    </small>

                    <strong>
                        ₹3,000
                    </strong>

                </div>

            </div>

            <div class="share-box">

                <label>
                    Your Cargo Weight
                </label>

                <div class="input-group">

                    <input type="number"
                           class="form-control"
                           value="300" />

                    <span class="input-group-text">
                        kg
                    </span>

                </div>

                <p>

                    Estimated Share:
                    <strong>
                        ₹1,000
                    </strong>

                </p>

                <button class="btn farm-btn-primary">

                    Join Trip

                </button>

            </div>

        </div>

    </div>

</div>