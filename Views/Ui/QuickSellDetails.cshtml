@{
    ViewData["Title"] = "Quick Sell Details";
}

<div class="detail-page">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-6">

                <div class="quick-large-image">

                    <i class="fa-solid fa-seedling"></i>

                    <span class="urgent-badge">
                        URGENT HARVEST
                    </span>

                </div>

            </div>


            <div class="col-lg-6">

                <h1>
                    Bulk Tomatoes
                </h1>

                <p class="farmer-origin">

                    Ramesh Farms • Anand

                </p>

                <div class="live-price-card">

                    <small>
                        Current Live Price
                    </small>

                    <h2 id="liveQuickPrice">
                        ₹22.50/kg
                    </h2>

                    <p>

                        Starting price
                        <del>
                            ₹30
                        </del>

                        • Floor price
                        ₹15

                    </p>

                    <div class="big-countdown">

                        <i class="fa-regular fa-clock"></i>

                        <span id="quickTimer">
                            24:15:30
                        </span>

                    </div>

                </div>

                <p>

                    <strong>Available Quantity:</strong>
                    350 kg

                </p>

                <label class="form-label">
                    Bulk Quantity Required
                </label>

                <input type="number"
                       class="form-control mb-3"
                       placeholder="kg" />

                <button class="btn farm-btn-primary btn-lg w-100">

                    Purchase at Current Price

                </button>

            </div>

        </div>

    </div>

</div>