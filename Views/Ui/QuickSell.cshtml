@model IEnumerable<FarmGrid.Models.QuickSellListing>
@{
    ViewData["Title"] = "Quick Sell Marketplace";
    var selectedCat = (string?)ViewBag.SelectedCategory ?? "All";
    var search = (string?)ViewBag.Search ?? "";
}

<div class="quick-page py-4">
    <div class="container">

        <div class="page-heading quick-heading d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
            <div>
                <span class="urgent-badge mb-2 d-inline-block">
                    <i class="fa-solid fa-bolt me-1"></i> Urgent Harvest
                </span>
                <h2 class="mb-1">Quick Sell Marketplace</h2>
                <p class="text-muted mb-0">
                    Surplus produce with prices falling automatically over 48 hours until the floor price.
                </p>
            </div>

            @if (User.IsInRole("Farmer"))
            {
                <div class="d-flex gap-2">
                    <a asp-controller="QuickSell" asp-action="Create" class="btn farm-btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Create Quick Sell
                    </a>
                </div>
            }
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="card p-3 mb-4 shadow-sm border-0 bg-light-subtle">
            <form method="get" asp-controller="QuickSell" asp-action="Index" class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        <input type="text" name="search" class="form-control bg-white" placeholder="Search surplus produce or location..." value="@search" />
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var cat in new[] { "All", "Vegetables", "Fruits", "Groceries" })
                        {
                            <a asp-controller="QuickSell" asp-action="Index" asp-route-category="@cat" asp-route-search="@search"
                               class="btn btn-sm @(selectedCat == cat ? "btn-success" : "btn-outline-secondary")">
                                @cat
                            </a>
                        }
                    </div>
                </div>
                <div class="col-md-2 text-md-end">
                    <button type="submit" class="btn farm-btn-primary btn-sm w-100">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 card border-0 shadow-sm p-5">
                <div class="text-muted mb-3">
                    <i class="fa-solid fa-wheat-awn-circle-exclamation fa-4x text-success opacity-50"></i>
                </div>
                <h4 class="text-muted">No active quick-sell listings right now</h4>
                <p class="text-muted">Check back soon or list your own surplus harvest!</p>
                <div class="mt-3">
                    <a asp-controller="QuickSell" asp-action="Create" class="btn farm-btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> List Surplus Produce
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    var currentPrice = item.CalculateCurrentPrice();
                    var remaining = item.GetRemainingTime();
                    var percentSaved = item.StartingPrice > 0 ? ((item.StartingPrice - currentPrice) / item.StartingPrice) * 100 : 0;

                    <div class="col-md-6 col-lg-4">
                        <div class="quick-card h-100 d-flex flex-column justify-content-between p-3 border rounded-3 shadow-sm bg-white position-relative">
                            <div>
                                <div class="quick-top d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                        <i class="fa-solid fa-fire me-1"></i> URGENT
                                    </span>
                                    <span class="badge bg-dark-subtle text-dark border px-2 py-1 fw-bold">
                                        @item.AvailableQuantity @item.UnitMeasure left
                                    </span>
                                </div>

                                <div class="quick-product-icon text-center text-success my-3" style="font-size: 2.8rem;">
                                    @if (item.Category == "Fruits")
                                    {
                                        <i class="fa-solid fa-apple-whole"></i>
                                    }
                                    else if (item.CropTitle.Contains("Tomato", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="fa-solid fa-seedling"></i>
                                    }
                                    else if (item.CropTitle.Contains("Carrot", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="fa-solid fa-carrot"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-leaf"></i>
                                    }
                                </div>

                                <h4 class="mb-1 text-center">@item.CropTitle</h4>
                                <p class="text-muted small text-center mb-3">
                                    <i class="fa-solid fa-location-dot me-1 text-success"></i> @item.FarmerName • @item.Location
                                </p>

                                <div class="price-drop d-flex justify-content-around align-items-center p-2 rounded bg-light mb-3 text-center">
                                    <div>
                                        <small class="text-muted d-block">Start</small>
                                        <del class="text-danger fw-semibold">₹@item.StartingPrice.ToString("F2")</del>
                                    </div>
                                    <div class="vr"></div>
                                    <div>
                                        <small class="text-muted d-block">Current Live</small>
                                        <strong class="text-success fs-5">₹@currentPrice.ToString("F2")</strong>
                                        <small class="text-muted">/@item.UnitMeasure</small>
                                    </div>
                                    <div class="vr"></div>
                                    <div>
                                        <small class="text-muted d-block">Floor</small>
                                        <span class="text-dark fw-semibold">₹@item.FloorPrice.ToString("F2")</span>
                                    </div>
                                </div>

                                <div class="countdown-bar text-center p-2 rounded mb-3 bg-danger-subtle text-danger fw-bold small live-timer-box"
                                     data-expires="@item.ExpiresAt.ToUtcIso()"
                                     data-start-price="@item.StartingPrice"
                                     data-floor-price="@item.FloorPrice"
                                     data-duration="@item.DurationHours"
                                     data-created="@item.CreatedAt.ToUtcIso()">
                                    <i class="fa-regular fa-clock me-1"></i>
                                    <span class="timer-display">
                                        @string.Format("{0:D2}:{1:D2}:{2:D2} remaining", (int)remaining.TotalHours, remaining.Minutes, remaining.Seconds)
                                    </span>
                                </div>
                            </div>

                            <a asp-controller="QuickSell" asp-action="Details" asp-route-id="@item.Id"
                               class="btn farm-btn-primary w-100 mt-2">
                                <i class="fa-solid fa-bolt me-1"></i> View Deal
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function updateCountdowns() {
                const timerBoxes = document.querySelectorAll(".live-timer-box");
                const now = new Date();

                timerBoxes.forEach(box => {
                    const expiresAt = new Date(box.getAttribute("data-expires"));
                    const diffMs = expiresAt - now;

                    const display = box.querySelector(".timer-display");
                    if (!display) return;

                    if (diffMs <= 0) {
                        display.innerText = "Listing Expired";
                        box.classList.remove("bg-danger-subtle", "text-danger");
                        box.classList.add("bg-secondary-subtle", "text-secondary");
                    } else {
                        const totalSeconds = Math.floor(diffMs / 1000);
                        const hours = Math.floor(totalSeconds / 3600);
                        const minutes = Math.floor((totalSeconds % 3600) / 60);
                        const seconds = totalSeconds % 60;
                        display.innerText = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')} remaining`;
                    }
                });
            }

            setInterval(updateCountdowns, 1000);
            updateCountdowns();
        });
    </script>
}