@{
    ViewData["Title"] = "Quick Sell";
}

<div class="quick-page">

    <div class="container">

        <div class="page-heading quick-heading">

            <div>

                <span class="urgent-badge">
                    Urgent Harvest
                </span>

                <h2>
                    Quick Sell Marketplace
                </h2>

                <p>
                    Bulk produce with prices decreasing
                    automatically over 48 hours.
                </p>

            </div>

            <a asp-action="QuickSellCreate"
               class="btn farm-btn-primary">

                Create Quick Sell

            </a>

        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-4">

                <div class="quick-card">

                    <div class="quick-top">

                        <span class="urgent-badge">
                            URGENT
                        </span>

                        <span>
                            350 kg
                        </span>

                    </div>

                    <div class="quick-product-icon">

                        <i class="fa-solid fa-seedling"></i>

                    </div>

                    <h4>
                        Bulk Tomatoes
                    </h4>

                    <p>
                        Ramesh Farms • Anand
                    </p>

                    <div class="price-drop">

                        <div>

                            <small>
                                Starting
                            </small>

                            <del>
                                ₹30/kg
                            </del>

                        </div>

                        <div>

                            <small>
                                Current
                            </small>

                            <strong>
                                ₹22.50/kg
                            </strong>

                        </div>

                    </div>

                    <div class="countdown"
                         data-hours="24">

                        <i class="fa-regular fa-clock"></i>

                        <span>
                            24:15:30 remaining
                        </span>

                    </div>

                    <a asp-action="QuickSellDetails"
                       class="btn farm-btn-primary w-100">

                        View Bulk Deal

                    </a>

                </div>

            </div>


            <div class="col-md-6 col-lg-4">

                <div class="quick-card">

                    <div class="quick-top">

                        <span class="urgent-badge">
                            URGENT
                        </span>

                        <span>
                            500 kg
                        </span>

                    </div>

                    <div class="quick-product-icon">

                        <i class="fa-solid fa-carrot"></i>

                    </div>

                    <h4>
                        Bulk Carrots
                    </h4>

                    <p>
                        Patel Farms • Kheda
                    </p>

                    <div class="price-drop">

                        <div>

                            <small>
                                Starting
                            </small>

                            <del>
                                ₹45/kg
                            </del>

                        </div>

                        <div>

                            <small>
                                Current
                            </small>

                            <strong>
                                ₹32/kg
                            </strong>

                        </div>

                    </div>

                    <div class="countdown">

                        <i class="fa-regular fa-clock"></i>

                        <span>
                            17:42:12 remaining
                        </span>

                    </div>

                    <a asp-action="QuickSellDetails"
                       class="btn farm-btn-primary w-100">

                        View Bulk Deal

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>