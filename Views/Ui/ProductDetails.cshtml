@model FarmGrid.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="detail-page">

    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-6">

                <div class="large-product-image">

                    <i class="fa-solid fa-seedling"></i>

                </div>

            </div>

            <div class="col-lg-6">

                <span class="farm-badge">
                    @Model.Category
                </span>

                <h1>
                    @Model.Title
                </h1>

                <p class="farmer-origin">

                    <i class="fa-solid fa-location-dot"></i>

                    FarmGrid Farmer

                </p>

                <p class="product-description">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Fresh agricultural produce directly from the farmer."
                        : Model.Description)

                </p>

                <div class="detail-price">

                    ₹@Model.UnitPrice.ToString("0.00")

                    <span>
                        / @Model.UnitMeasure
                    </span>

                </div>

                <p>

                    <strong>Available Stock:</strong>

                    @Model.StockQuantity
                    @Model.UnitMeasure

                </p>

                <form asp-controller="Cart"
                      asp-action="Add"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="productId"
                           value="@Model.Id" />

                    <div class="quantity-row">

                        <label class="form-label">
                            Quantity
                        </label>

                        <input type="number"
                               name="quantity"
                               value="1"
                               min="0.01"
                               max="@Model.StockQuantity"
                               step="0.01"
                               class="form-control quantity-input" />

                    </div>

                    <div class="d-flex gap-3 mt-4">

                        <button type="submit"
                                class="btn farm-btn-primary btn-lg">

                            <i class="fa-solid fa-cart-shopping"></i>

                            Add to Cart

                        </button>

                        <a asp-controller="Products"
                           asp-action="Index"
                           class="btn farm-btn-outline btn-lg">

                            Back

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>