@model FarmGrid.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<div class="detail-page">

    <div class="container">

        <div class="row g-5 align-items-center">

            <div class="col-lg-6">

                <div class="large-product-image">

                    <i class="fa-solid fa-seedling"></i>

                </div>

            </div>

            <div class="col-lg-6">

                <span class="farm-badge">
                    @Model.Category
                </span>

                <h1>
                    @Model.Title
                </h1>

                <p class="farmer-origin">

                    <i class="fa-solid fa-location-dot"></i>

                    @(Model.Farmer?.FullName ?? "FarmGrid Farmer")

                </p>

                <p class="product-description">

                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "Fresh agricultural produce directly from the farmer."
                        : Model.Description)

                </p>

                <div class="detail-price">

                    ₹@Model.UnitPrice.ToString("0.00")

                    <span>
                        / @Model.UnitMeasure
                    </span>

                </div>

                <p>

                    <strong>Available Stock:</strong>

                    @Model.StockQuantity
                    @Model.UnitMeasure

                </p>

                @if (Model.FarmerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                {
                    <div class="card p-3 bg-light-subtle border rounded-3 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="fa-solid fa-tractor me-1"></i> Farmer Management
                            </span>
                            <span class="text-muted small">You are viewing this product in Seller Mode</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@Model.Id" class="btn farm-btn-primary">
                                <i class="fa-solid fa-pen-to-square me-1"></i> Edit Product
                            </a>
                            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
                                Back to Catalog
                            </a>
                        </div>
                    </div>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="d-flex gap-3 mt-4">
                        <a asp-controller="Account"
                           asp-action="Login"
                           asp-route-returnUrl="@Url.Action("Details", "Products", new { id = Model.Id })"
                           class="btn farm-btn-primary btn-lg">
                            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign in to buy
                        </a>
                        <a asp-controller="Products" asp-action="Index" class="btn farm-btn-outline btn-lg">Back</a>
                    </div>
                }
                else if (User.IsInRole("Customer"))
                {
                    <form asp-controller="Cart"
                          asp-action="Add"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="productId"
                               value="@Model.Id" />

                        <div class="quantity-row">

                            <label class="form-label">
                                Quantity
                            </label>

                            <input type="number"
                                   name="quantity"
                                   value="1"
                                   min="@(ProduceUnits.Find(Model.UnitMeasure)?.Step ?? "0.01")"
                                   max="@Model.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   step="@(ProduceUnits.Find(Model.UnitMeasure)?.Step ?? "0.01")"
                                   class="form-control quantity-input" />

                        </div>

                        <div class="d-flex gap-3 mt-4">

                            <button type="submit"
                                    class="btn farm-btn-primary btn-lg">

                                <i class="fa-solid fa-cart-shopping me-1"></i> Add to Cart

                            </button>

                            <a asp-controller="Products"
                               asp-action="Index"
                               class="btn farm-btn-outline btn-lg">

                                Back

                            </a>

                        </div>

                    </form>
                }

            </div>

        </div>

    </div>

</div>