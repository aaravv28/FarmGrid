@model FarmGrid.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";

    decimal subtotal =
        ViewBag.Subtotal ?? 0;

    decimal deliveryCharge =
        ViewBag.DeliveryCharge ?? 30;

    decimal total =
        ViewBag.Total ?? subtotal + deliveryCharge;

    var plan =
        (IReadOnlyList<FarmGrid.Models.FarmerOrderPlan>?)ViewBag.Plan
        ?? Array.Empty<FarmGrid.Models.FarmerOrderPlan>();

    var farmerNames =
        (IDictionary<string, string>?)ViewBag.FarmerNames
        ?? new Dictionary<string, string>();
}

<div class="form-page">

    <div class="container">

        <form asp-controller="Orders"
              asp-action="Checkout"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row g-4">

                <div class="col-lg-8">

                    <div class="form-card">

                        <h3>
                            Delivery Details
                        </h3>

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="CustomerName"
                                       class="form-label">
                                    Full Name
                                </label>

                                <input asp-for="CustomerName"
                                       class="form-control" />

                                <span asp-validation-for="CustomerName"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="PhoneNumber"
                                       class="form-label">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       placeholder="+91" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                        <div class="mb-3">

                            <label asp-for="DeliveryAddress"
                                   class="form-label">
                                Address
                            </label>

                            <textarea asp-for="DeliveryAddress"
                                      class="form-control"
                                      rows="3">
                            </textarea>

                            <span asp-validation-for="DeliveryAddress"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="City"
                                       class="form-label">
                                    City
                                </label>

                                <input asp-for="City"
                                       class="form-control" />

                                <span asp-validation-for="City"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="DeliverySlot"
                                       class="form-label">
                                    Delivery Slot
                                </label>

                                <select asp-for="DeliverySlot"
                                        class="form-select">

                                    <option value="6 AM - 9 AM">
                                        6 AM - 9 AM
                                    </option>

                                    <option value="9 AM - 12 PM">
                                        9 AM - 12 PM
                                    </option>

                                    <option value="4 PM - 7 PM">
                                        4 PM - 7 PM
                                    </option>

                                </select>

                            </div>

                        </div>

                        <h5 class="mt-4">
                            Payment
                        </h5>

                        <div class="payment-option">

                            <i class="fa-solid fa-money-bill-wave text-success me-2"></i>

                            <span>
                                Cash on Delivery
                            </span>

                        </div>

                    </div>

                </div>

                <div class="col-lg-4">

                    <div class="order-summary">

                        <h4>
                            Order Summary
                        </h4>

                        @if (plan.Count > 1)
                        {
                            <p class="small text-muted">
                                Your cart has produce from @plan.Count farmers. Each farmer delivers separately, so you'll get @plan.Count orders, each with its own delivery charge.
                            </p>
                        }

                        @foreach (var farmerPlan in plan)
                        {
                            var farmerName = farmerPlan.FarmerId != null && farmerNames.TryGetValue(farmerPlan.FarmerId, out var name)
                                ? name
                                : "FarmGrid Farmer";

                            <div class="d-block mb-3 pb-2 border-bottom">

                                <h6 class="fw-bold mb-2">
                                    <i class="fa-solid fa-tractor text-success me-1"></i> @farmerName
                                </h6>

                                @foreach (var item in farmerPlan.Items)
                                {
                                    <div class="small">
                                        <span>@item.Product!.Title × @item.Quantity @item.Product.UnitMeasure</span>
                                        <span>₹@((item.Product.UnitPrice * item.Quantity).ToString("0.00"))</span>
                                    </div>
                                }

                                <div class="small">
                                    <span>Delivery</span>
                                    <span>₹@farmerPlan.DeliveryCharge.ToString("0.00")</span>
                                </div>

                            </div>
                        }

                        <div>

                            <span>Products</span>

                            <strong>
                                ₹@subtotal.ToString("0.00")
                            </strong>

                        </div>

                        <div>

                            <span>Delivery (@plan.Count × ₹@FarmGrid.Models.CheckoutPlan.DeliveryChargePerOrder.ToString("0"))</span>

                            <strong>
                                ₹@deliveryCharge.ToString("0.00")
                            </strong>

                        </div>

                        <hr />

                        <div class="summary-total">

                            <span>Total</span>

                            <strong>
                                ₹@total.ToString("0.00")
                            </strong>

                        </div>

                        <button type="submit"
                                class="btn farm-btn-primary w-100 mt-4">

                            Place @(plan.Count > 1 ? $"{plan.Count} Orders" : "Order")

                        </button>

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}