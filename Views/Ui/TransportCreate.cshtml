@model FarmGrid.Models.TransportTrip

@{
    ViewData["Title"] = "Create Transport Trip";
}

<div class="form-page">

    <div class="container">

        <div class="form-card">

            <h2>
                Create Transport Trip
            </h2>

            <p>
                Register spare vehicle capacity for other farmers.
            </p>

            <form asp-controller="Transport"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <label asp-for="DestinationMarket"
                           class="form-label">
                        Destination Market
                    </label>

                    <select asp-for="DestinationMarket"
                            class="form-select">

                        <option value="">
                            Select Destination
                        </option>

                        <option value="Central Mandi">
                            Central Mandi
                        </option>

                        <option value="City Hub">
                            City Hub
                        </option>

                        <option value="Wholesale Market">
                            Wholesale Market
                        </option>

                    </select>

                    <span asp-validation-for="DestinationMarket"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="DispatchDate"
                           class="form-label">
                        Dispatch Date
                    </label>

                    <input asp-for="DispatchDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DispatchDate"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="VehicleType"
                               class="form-label">
                            Vehicle Type
                        </label>

                        <input asp-for="VehicleType"
                               class="form-control"
                               placeholder="Example Tata Ace" />

                        <span asp-validation-for="VehicleType"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="TotalVehicleCost"
                               class="form-label">
                            Total Vehicle Cost
                        </label>

                        <input asp-for="TotalVehicleCost"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="₹" />

                        <span asp-validation-for="TotalVehicleCost"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="HostCargoWeightKg"
                               class="form-label">
                            Your Cargo Weight
                        </label>

                        <input asp-for="HostCargoWeightKg"
                               type="number"
                               step="0.01"
                               min="0.01"
                               class="form-control"
                               placeholder="kg" />

                        <span asp-validation-for="HostCargoWeightKg"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-4">

                        <label asp-for="AvailableCapacityKg"
                               class="form-label">
                            Available Spare Capacity
                        </label>

                        <input asp-for="AvailableCapacityKg"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control"
                               placeholder="kg" />

                        <span asp-validation-for="AvailableCapacityKg"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <button type="submit"
                        class="btn farm-btn-primary">

                    Create Transport Trip

                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}