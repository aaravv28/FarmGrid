@model IEnumerable<FarmGrid.Models.CartItem>

@{
    var deliveryPlan = FarmGrid.Models.CheckoutPlan.Build(Model);
    decimal deliveryCharge = deliveryPlan.Sum(p => p.DeliveryCharge);

    ViewData["Title"] = "Shopping Cart";

    decimal subtotal = Model
        .Where(x => x.Product != null)
        .Sum(x => x.Product!.UnitPrice * x.Quantity);

    var problemCount = Model.Count(x => CartChecks.ProblemWith(x) != null);
}

<div class="cart-page">

    <div class="container">

        <h2 class="mb-4">
            Shopping Cart
        </h2>


        @if (!Model.Any())
        {
            <div class="dashboard-card text-center">

                <h4>
                    Your cart is empty
                </h4>

                <p>
                    Add some fresh products from the marketplace.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn farm-btn-primary">

                    Browse Products

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                <div class="col-lg-8">

                    @foreach (var item in Model)
                    {
                        if (item.Product == null)
                        {
                            continue;
                        }

                        <div class="cart-item">

                            <div class="cart-icon">

                                <i class="fa-solid fa-seedling"></i>

                            </div>

                            <div class="cart-info">

                                <h5>
                                    @item.Product.Title
                                </h5>

                                <p>
                                    ₹@item.Product.UnitPrice.ToString("0.00")
                                    /
                                    @item.Product.UnitMeasure
                                </p>

                                @if (CartChecks.ProblemWith(item) is string problem)
                                {
                                    <p class="small text-danger fw-semibold mb-0">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i> @problem
                                    </p>
                                }

                            </div>

                            <form asp-controller="Cart"
                                  asp-action="Update"
                                  method="post"
                                  class="d-flex align-items-center gap-2">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <input type="number"
                                       name="quantity"
                                       value="@item.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       min="@(ProduceUnits.Find(item.Product.UnitMeasure)?.Step ?? "0.01")"
                                       max="@item.Product.StockQuantity.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       step="@(ProduceUnits.Find(item.Product.UnitMeasure)?.Step ?? "0.01")"
                                       class="form-control"
                                       style="width:100px;" />

                                <button type="submit"
                                        class="btn farm-btn-outline">

                                    Update

                                </button>

                            </form>

                            <strong>

                                ₹@((item.Product.UnitPrice * item.Quantity)
                                                                    .ToString("0.00"))

                            </strong>

                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="remove-btn">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>

                        </div>
                    }

                </div>

                <div class="col-lg-4">

                    <div class="order-summary">

                        <h4>
                            Order Summary
                        </h4>

                        <div>

                            <span>Subtotal</span>

                            <strong>
                                ₹@subtotal.ToString("0.00")
                            </strong>

                        </div>

                        <div>

                            <span>Delivery@(deliveryPlan.Count > 1 ? $" ({deliveryPlan.Count} farmers)" : "")</span>

                            <strong>
                                ₹@deliveryCharge.ToString("0.00")
                            </strong>

                        </div>

                        <hr />

                        <div class="summary-total">

                            <span>Total</span>

                            <strong>
                                ₹@((subtotal + deliveryCharge).ToString("0.00"))
                            </strong>

                        </div>

                        @if (problemCount > 0)
                        {
                            <p class="small text-danger mt-3 mb-0">
                                Fix the @(problemCount == 1 ? "item" : $"{problemCount} items") marked above before checking out.
                            </p>

                            <span class="btn farm-btn-primary w-100 mt-2 disabled" aria-disabled="true">

                                Proceed to Checkout

                            </span>
                        }
                        else
                        {
                            <a asp-controller="Orders"
                               asp-action="Checkout"
                               class="btn farm-btn-primary w-100 mt-4">

                                Proceed to Checkout

                            </a>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>