@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page">

    <div class="container">

        <h2 class="mb-4">
            Shopping Cart
        </h2>

        <div class="row g-4">

            <div class="col-lg-8">

                <div class="cart-item">

                    <div class="cart-icon">

                        <i class="fa-solid fa-seedling"></i>

                    </div>

                    <div class="cart-info">

                        <h5>
                            Fresh Tomatoes
                        </h5>

                        <p>
                            ₹40 / kg
                        </p>

                    </div>

                    <div class="cart-quantity">

                        <button>-</button>

                        <span>2</span>

                        <button>+</button>

                    </div>

                    <strong>
                        ₹80
                    </strong>

                    <button class="remove-btn">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>


                <div class="cart-item">

                    <div class="cart-icon">

                        <i class="fa-solid fa-apple-whole"></i>

                    </div>

                    <div class="cart-info">

                        <h5>
                            Fresh Apples
                        </h5>

                        <p>
                            ₹160 / kg
                        </p>

                    </div>

                    <div class="cart-quantity">

                        <button>-</button>

                        <span>1</span>

                        <button>+</button>

                    </div>

                    <strong>
                        ₹160
                    </strong>

                    <button class="remove-btn">

                        <i class="fa-solid fa-trash"></i>

                    </button>

                </div>

            </div>


            <div class="col-lg-4">

                <div class="order-summary">

                    <h4>
                        Order Summary
                    </h4>

                    <div>

                        <span>Subtotal</span>
                        <strong>₹240</strong>

                    </div>

                    <div>

                        <span>Delivery</span>
                        <strong>₹30</strong>

                    </div>

                    <hr />

                    <div class="summary-total">

                        <span>Total</span>
                        <strong>₹270</strong>

                    </div>

                    <a asp-action="Checkout"
                       class="btn farm-btn-primary w-100 mt-4">

                        Proceed to Checkout

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>