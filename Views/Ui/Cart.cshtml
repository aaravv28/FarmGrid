@model IEnumerable<FarmGrid.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";

    decimal subtotal = Model
        .Where(x => x.Product != null)
        .Sum(x => x.Product!.UnitPrice * x.Quantity);
}

<div class="cart-page">

    <div class="container">

        <h2 class="mb-4">
            Shopping Cart
        </h2>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (!Model.Any())
        {
            <div class="dashboard-card text-center">

                <h4>
                    Your cart is empty
                </h4>

                <p>
                    Add some fresh products from the marketplace.
                </p>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn farm-btn-primary">

                    Browse Products

                </a>

            </div>
        }
        else
        {
            <div class="row g-4">

                <div class="col-lg-8">

                    @foreach (var item in Model)
                    {
                        if (item.Product == null)
                        {
                            continue;
                        }

                        <div class="cart-item">

                            <div class="cart-icon">

                                <i class="fa-solid fa-seedling"></i>

                            </div>

                            <div class="cart-info">

                                <h5>
                                    @item.Product.Title
                                </h5>

                                <p>
                                    ₹@item.Product.UnitPrice.ToString("0.00")
                                    /
                                    @item.Product.UnitMeasure
                                </p>

                            </div>

                            <form asp-controller="Cart"
                                  asp-action="Update"
                                  method="post"
                                  class="d-flex align-items-center gap-2">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <input type="number"
                                       name="quantity"
                                       value="@item.Quantity"
                                       min="0.01"
                                       max="@item.Product.StockQuantity"
                                       step="0.01"
                                       class="form-control"
                                       style="width:100px;" />

                                <button type="submit"
                                        class="btn farm-btn-outline">

                                    Update

                                </button>

                            </form>

                            <strong>

                                ₹@((item.Product.UnitPrice * item.Quantity)
                                                                    .ToString("0.00"))

                            </strong>

                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="remove-btn">

                                    <i class="fa-solid fa-trash"></i>

                                </button>

                            </form>

                        </div>
                    }

                </div>

                <div class="col-lg-4">

                    <div class="order-summary">

                        <h4>
                            Order Summary
                        </h4>

                        <div>

                            <span>Subtotal</span>

                            <strong>
                                ₹@subtotal.ToString("0.00")
                            </strong>

                        </div>

                        <div>

                            <span>Delivery</span>

                            <strong>
                                ₹30.00
                            </strong>

                        </div>

                        <hr />

                        <div class="summary-total">

                            <span>Total</span>

                            <strong>
                                ₹@((subtotal + 30).ToString("0.00"))
                            </strong>

                        </div>

                        <a asp-controller="Orders"
                           asp-action="Checkout"
                           class="btn farm-btn-primary w-100 mt-4">

                            Proceed to Checkout

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>