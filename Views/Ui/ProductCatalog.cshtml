@model IEnumerable<FarmGrid.Models.Product>

@{
    ViewData["Title"] = "Marketplace";
}

<div class="market-page">

    <div class="container">

        <div class="page-heading">

            <div>

                <span class="farm-badge">
                    Farm Fresh
                </span>

                <h2>
                    Fresh Produce Marketplace
                </h2>

                <p>
                    Buy directly from verified local farmers.
                </p>

            </div>

            <a asp-controller="Products"
               asp-action="Create"
               class="btn farm-btn-primary">

                Add Product

            </a>

        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form method="get"
              asp-controller="Products"
              asp-action="Index"
              class="market-toolbar">

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       placeholder="Search fruits vegetables dairy..." />

            </div>

            <select name="category"
                    class="form-select category-filter">

                <option value="">
                    All Categories
                </option>

                <option value="Fruits">
                    Fruits
                </option>

                <option value="Vegetables">
                    Vegetables
                </option>

                <option value="Groceries">
                    Groceries
                </option>

                <option value="Dairy Products">
                    Dairy Products
                </option>

            </select>

            <button type="submit"
                    class="btn farm-btn-primary">

                Filter

            </button>

        </form>

        @if (!Model.Any())
        {
            <div class="dashboard-card text-center">

                <h4>
                    No products found
                </h4>

                <p>
                    There are currently no matching products.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var product in Model)
                {
                    string icon;
                    string backgroundClass;

                    switch (product.Category)
                    {
                        case "Fruits":
                            icon = "fa-apple-whole";
                            backgroundClass = "fruit-bg";
                            break;

                        case "Dairy Products":
                            icon = "fa-bottle-water";
                            backgroundClass = "dairy-bg";
                            break;

                        case "Groceries":
                            icon = "fa-wheat-awn";
                            backgroundClass = "grocery-bg";
                            break;

                        default:
                            icon = "fa-seedling";
                            backgroundClass = "tomato-bg";
                            break;
                    }

                    <div class="col-lg-3 col-md-6">

                        <div class="product-card">

                            <div class="product-image @backgroundClass">

                                <span class="product-category">
                                    @product.Category
                                </span>

                                <i class="fa-solid @icon"></i>

                            </div>

                            <div class="product-body">

                                <small>
                                    FarmGrid Farmer
                                </small>

                                <h5>
                                    @product.Title
                                </h5>

                                <p>
                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "Fresh agricultural produce."
                                        : product.Description)
                                </p>

                                <div class="product-price">

                                    <strong>
                                        ₹@product.UnitPrice.ToString("0.00")
                                    </strong>

                                    <span>
                                        / @product.UnitMeasure
                                    </span>

                                </div>

                                <small>
                                    Stock:
                                    @product.StockQuantity
                                    @product.UnitMeasure
                                </small>

                                <div class="product-actions">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn farm-btn-outline">

                                        View

                                    </a>

                                    <a asp-controller="Products"
                                       asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn farm-btn-outline">

                                        Edit

                                    </a>

                                </div>

                                <div class="product-actions mt-2">

                                    <form asp-controller="Cart"
                                          asp-action="Add"
                                          method="post"
                                          class="w-100">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="productId"
                                               value="@product.Id" />

                                        <input type="hidden"
                                               name="quantity"
                                               value="1" />

                                        <button type="submit"
                                                class="btn farm-btn-primary w-100">

                                            Add to Cart

                                        </button>

                                    </form>

                                    <form asp-controller="Products"
                                          asp-action="Delete"
                                          method="post"
                                          class="w-100"
                                          onsubmit="return confirm('Are you sure you want to remove this product?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@product.Id" />

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>