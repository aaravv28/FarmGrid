@model IEnumerable<FarmGrid.Models.Product>

@{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    ViewData["Title"] = "Marketplace";
}

<div class="market-page">

    <div class="container">

        <div class="page-heading">

            <div>

                <span class="farm-badge">
                    Farm Fresh
                </span>

                <h2>
                    Fresh Produce Marketplace
                </h2>

                <p>
                    Buy directly from verified local farmers.
                </p>

            </div>

            @if (User.IsInRole("Farmer"))
            {
                <a asp-controller="Products"
                   asp-action="Create"
                   class="btn farm-btn-primary">
                    <i class="fa-solid fa-plus me-1"></i> Add Product
                </a>
            }

        </div>


        <form method="get"
              asp-controller="Products"
              asp-action="Index"
              class="market-toolbar">

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       placeholder="Search fruits vegetables dairy..." />

            </div>

            <select name="category"
                    class="form-select category-filter">

                <option value="">
                    All Categories
                </option>

                @foreach (var category in ProduceCategories.All)
                {
                    <option value="@category" selected="@(Context.Request.Query["category"] == category)">@category</option>
                }


            </select>

            <button type="submit"
                    class="btn farm-btn-primary">

                Filter

            </button>

        </form>

        @if (!Model.Any())
        {
            <div class="dashboard-card text-center">

                <h4>
                    No products found
                </h4>

                <p>
                    There are currently no matching products.
                </p>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var product in Model)
                {
                    string icon;
                    string backgroundClass;

                    switch (product.Category)
                    {
                        case "Fruits":
                            icon = "fa-apple-whole";
                            backgroundClass = "fruit-bg";
                            break;

                        case "Dairy Products":
                            icon = "fa-bottle-water";
                            backgroundClass = "dairy-bg";
                            break;

                        case "Groceries":
                            icon = "fa-wheat-awn";
                            backgroundClass = "grocery-bg";
                            break;

                        default:
                            icon = "fa-seedling";
                            backgroundClass = "tomato-bg";
                            break;
                    }

                    <div class="col-lg-3 col-md-6">

                        <div class="product-card">

                            <div class="product-image @backgroundClass">

                                <span class="product-category">
                                    @product.Category
                                </span>

                                <i class="fa-solid @icon"></i>

                            </div>

                            <div class="product-body">

                                <small>
                                    @(product.Farmer?.FullName ?? "FarmGrid Farmer")
                                </small>

                                <h5>
                                    @product.Title
                                </h5>

                                <p>
                                    @(string.IsNullOrWhiteSpace(product.Description)
                                        ? "Fresh agricultural produce."
                                        : product.Description)
                                </p>

                                <div class="product-price">

                                    <strong>
                                        ₹@product.UnitPrice.ToString("0.00")
                                    </strong>

                                    <span>
                                        / @product.UnitMeasure
                                    </span>

                                </div>

                                <small>
                                    Stock:
                                    @product.StockQuantity
                                    @product.UnitMeasure
                                </small>

                                <div class="product-actions">
                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="btn farm-btn-outline w-100">
                                        View Details
                                    </a>
                                </div>

                                @if (product.FarmerId == currentUserId)
                                {
                                    <div class="product-actions mt-2 d-flex gap-2">
                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="btn btn-sm btn-outline-secondary w-50">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                        </a>

                                        <form asp-controller="Products"
                                              asp-action="Delete"
                                              method="post"
                                              class="w-50"
                                              onsubmit="return confirm('Are you sure you want to remove this product?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@product.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (User.IsInRole("Customer"))
                                {
                                    <div class="product-actions mt-2">
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="w-100">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn farm-btn-primary w-100">
                                                <i class="fa-solid fa-cart-plus me-1"></i> Add to Cart
                                            </button>
                                        </form>
                                    </div>
                                }
                                else if (User.Identity?.IsAuthenticated != true)
                                {
                                    <div class="product-actions mt-2">
                                        <a asp-controller="Account"
                                           asp-action="Login"
                                           asp-route-returnUrl="@Url.Action("Details", "Products", new { id = product.Id })"
                                           class="btn farm-btn-primary w-100">
                                            <i class="fa-solid fa-right-to-bracket me-1"></i> Sign in to buy
                                        </a>
                                    </div>
                                }

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</div>