@model IEnumerable<FarmGrid.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<div class="dashboard-page">

    <div class="container">

        <div class="page-heading">

            <div>

                <h2>
                    My Orders
                </h2>

                <p>
                    Track current and previous FarmGrid orders.
                </p>

            </div>

            <a asp-controller="Products"
               asp-action="Index"
               class="btn farm-btn-primary">

                Continue Shopping

            </a>

        </div>

        <div class="dashboard-card">

            @if (!Model.Any())
            {
                <div class="text-center">

                    <h4>
                        No orders yet
                    </h4>

                    <p>
                        Your FarmGrid orders will appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table farm-table">

                        <thead>

                            <tr>

                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                <tr>

                                    <td>
                                        #FG@order.Id.ToString("D4")
                                    </td>

                                    <td>
                                        @order.CreatedAt.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @order.OrderItems.Count
                                    </td>

                                    <td>
                                        ₹@order.TotalAmount.ToString("0.00")
                                    </td>

                                    <td>

                                        <span class="status active">
                                            @order.Status
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>