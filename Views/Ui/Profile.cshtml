@{
    ViewData["Title"] = "Profile";
}

<div class="form-page">

    <div class="container">

        <div class="form-card">

            <div class="profile-top">

                <div class="profile-avatar">

                    <i class="fa-solid fa-user"></i>

                </div>

                <div>

                    <h2>
                        My Profile
                    </h2>

                    <p>
                        Manage personal and location information.
                    </p>

                </div>

            </div>

            <form>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Full Name
                        </label>

                        <input class="form-control"
                               value="Aarav" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            Contact Number
                        </label>

                        <input class="form-control"
                               placeholder="+91" />

                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Email
                    </label>

                    <input type="email"
                           class="form-control"
                           placeholder="example@email.com" />

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            City
                        </label>

                        <select class="form-select">

                            <option>Vadodara</option>
                            <option>Ahmedabad</option>
                            <option>Anand</option>
                            <option>Surat</option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label">
                            District
                        </label>

                        <select class="form-select">

                            <option>Vadodara</option>
                            <option>Anand</option>
                            <option>Kheda</option>

                        </select>

                    </div>

                </div>

                <button class="btn farm-btn-primary">

                    Save Profile

                </button>

            </form>

        </div>

    </div>

</div>
