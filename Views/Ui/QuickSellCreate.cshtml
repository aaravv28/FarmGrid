@model FarmGrid.ViewModels.QuickSellCreateViewModel
@{
    ViewData["Title"] = "Create Quick Sell";
}

<div class="form-page py-4">
    <div class="container">
        <div class="form-card mx-auto shadow-sm p-4 p-md-5 border rounded-4 bg-white" style="max-width: 680px;">
            <div class="text-center mb-4">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fs-6">
                    <i class="fa-solid fa-bolt me-1"></i> Urgent Harvest Listing
                </span>
                <h2 class="mt-3 mb-1">Create Quick Sell Listing</h2>
                <p class="text-muted">
                    Clear surplus or highly perishable harvest with a price that falls automatically over 48 hours.
                </p>
            </div>

            <form asp-controller="QuickSell" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CropTitle" class="form-label fw-semibold"></label>
                    <input asp-for="CropTitle" class="form-control" placeholder="e.g. Hybrid Tomatoes, Fresh Potatoes" autofocus />
                    <span asp-validation-for="CropTitle" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label fw-semibold"></label>
                        <select asp-for="Category" class="form-select">
                            @foreach (var category in ProduceCategories.All)
                            {
                                <option value="@category">@category</option>
                            }
                        </select>
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BulkQuantity" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="BulkQuantity" type="number" step="1" class="form-control" placeholder="e.g. 500" />
                            <span class="input-group-text bg-light">kg</span>
                        </div>
                        <span asp-validation-for="BulkQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartingPrice" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input asp-for="StartingPrice" id="startPriceInput" type="number" step="0.5" class="form-control" placeholder="e.g. 30" />
                            <span class="input-group-text bg-light">/kg</span>
                        </div>
                        <span asp-validation-for="StartingPrice" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FloorPrice" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₹</span>
                            <input asp-for="FloorPrice" id="floorPriceInput" type="number" step="0.5" class="form-control" placeholder="e.g. 15" />
                            <span class="input-group-text bg-light">/kg</span>
                        </div>
                        <span asp-validation-for="FloorPrice" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label fw-semibold"></label>
                    <input asp-for="Location" class="form-control" placeholder="e.g. Anand, Anand district" />
                    <span asp-validation-for="Location" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Harvest date, quality grading, packaging notes..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Live Decay Simulator Box -->
                <div class="decay-info p-3 mb-4 rounded-3 border bg-light-subtle">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <div>
                            <strong class="d-block text-success">48-Hour Dynamic Dutch Decay Engine</strong>
                            <small class="text-muted">Prices drop gradually per hour but never go lower than your floor price.</small>
                        </div>
                    </div>
                    <div id="decayPreview" class="small border-top pt-2 mt-2 text-secondary">
                        Fill in starting price and floor price above to simulate hourly price drop.
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-controller="QuickSell" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Marketplace
                    </a>
                    <button type="submit" class="btn farm-btn-primary px-4 py-2">
                        <i class="fa-solid fa-rocket me-1"></i> Launch Quick Sell
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const startInput = document.getElementById("startPriceInput");
            const floorInput = document.getElementById("floorPriceInput");
            const preview = document.getElementById("decayPreview");

            function updateDecayPreview() {
                const start = parseFloat(startInput.value);
                const floor = parseFloat(floorInput.value);

                if (!isNaN(start) && !isNaN(floor) && start > floor && floor > 0) {
                    const dropPerHour = (start - floor) / 48;
                    const p12 = Math.max(floor, start - (dropPerHour * 12)).toFixed(2);
                    const p24 = Math.max(floor, start - (dropPerHour * 24)).toFixed(2);
                    const p36 = Math.max(floor, start - (dropPerHour * 36)).toFixed(2);

                    preview.innerHTML = `
                        <div class="d-flex justify-content-between mb-1">
                            <span>Drop rate: <strong>₹${dropPerHour.toFixed(2)}/hour</strong></span>
                            <span>Total drop window: <strong>48 hours</strong></span>
                        </div>
                        <div class="row text-center mt-2 g-1">
                            <div class="col-3 p-1 bg-white border rounded">
                                <span class="d-block text-muted" style="font-size:0.75rem;">12h mark</span>
                                <strong class="text-dark">₹${p12}</strong>
                            </div>
                            <div class="col-3 p-1 bg-white border rounded">
                                <span class="d-block text-muted" style="font-size:0.75rem;">24h mark</span>
                                <strong class="text-dark">₹${p24}</strong>
                            </div>
                            <div class="col-3 p-1 bg-white border rounded">
                                <span class="d-block text-muted" style="font-size:0.75rem;">36h mark</span>
                                <strong class="text-dark">₹${p36}</strong>
                            </div>
                            <div class="col-3 p-1 bg-white border rounded">
                                <span class="d-block text-muted" style="font-size:0.75rem;">48h (Floor)</span>
                                <strong class="text-success">₹${floor.toFixed(2)}</strong>
                            </div>
                        </div>
                    `;
                } else if (start <= floor && !isNaN(start) && !isNaN(floor)) {
                    preview.innerHTML = `<span class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Starting price must be strictly greater than floor price.</span>`;
                } else {
                    preview.innerHTML = `Fill in starting price and floor price above to simulate hourly price drop.`;
                }
            }

            startInput.addEventListener("input", updateDecayPreview);
            floorInput.addEventListener("input", updateDecayPreview);
            updateDecayPreview();
        });
    </script>
}